# mypy
.mypy_cache/

.idea
/models
screenshots/*.png
screenshots/*.mp4
screenshots/*.webm

replays/

# Measurements are the evidence for the report's Experiments chapter and are
# small text files -- they stay versioned. Training logs in particular cannot be
# reproduced: --seed fixes the arenas, not the agent's exploration RNG.
# Figures are pure functions of the CSVs, so they are not worth versioning.
results/figures/

final_project.pdf

# stdout of parallel training sweeps; the training CSV is the record
logs/*.out

# scratchpad/<person>/ holds dev-only helper scripts (table dumps, policy replays).
# Not part of the submission, but they produce numbers that end up in the report,
# so they are versioned.
#
# Q-table snapshots are not: every trained table is already in the history as
# agent_code/<agent>/q_table.npy at the commit that produced it. Recover one with
#   git show <commit>:agent_code/<agent>/q_table.npy > scratchpad/<person>/models/q_vN.npy
scratchpad/*/models/

# Per-run Q-tables from parallel training (BM_MODEL_SUFFIX). The real model is
# q_table.npy and stays versioned; these are scratch and must never end up in
# the submitted agent folder.
agent_code/*/q_table_*.npy

# macOS
.DS_Store
