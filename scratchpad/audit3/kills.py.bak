#!/usr/bin/env python3
"""Who actually killed whom.

`evaluate.py` derives killed_by_opponent = died - suicides. That is wrong
whenever a death is covered by BOTH the agent's own bomb and an opponent's:
environment.evaluate_explosions credits KILLED_OPPONENT (+5) to every foreign
explosion covering the victim, while KILLED_SELF is also fired. The victim is
then recorded as a pure suicide and the opponents' +5 is invisible.

This mirrors that loop exactly and records (victim, owner) pairs.
"""
from __future__ import annotations
import os, sys, json
from pathlib import Path
from collections import Counter, defaultdict

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))

import numpy as np
import environment as envmod
from environment import BombeRLeWorld, WorldArgs

PAIRS: Counter = Counter()
_orig = envmod.GenericWorld.evaluate_explosions


def patched(self):
    for explosion in self.explosions:
        if explosion.is_dangerous():
            for a in self.active_agents:
                if (not a.dead) and (a.x, a.y) in explosion.blast_coords:
                    PAIRS[(a.name, explosion.owner.name)] += 1
    return _orig(self)


envmod.GenericWorld.evaluate_explosions = patched


def run(agents, n_rounds, seed, tag):
    args = WorldArgs(no_gui=True, fps=15, turn_based=False, update_interval=0.1,
                     save_replay=False, replay=None, make_video=False,
                     continue_without_training=True, log_dir=str(ROOT / "scratchpad/audit3/logs/k"),
                     save_stats=False, match_name=tag, seed=seed, silence_errors=False,
                     scenario="classic")
    (ROOT / "scratchpad/audit3/logs/k").mkdir(parents=True, exist_ok=True)
    world = BombeRLeWorld(args, [(n, False) for n in agents])
    stats = defaultdict(Counter)
    try:
        for i in range(n_rounds):
            world.rng = np.random.default_rng(seed + i)
            np.random.seed(seed + i)
            world.new_round()
            while world.running:
                world.do_step()
            for a in world.agents:
                stats[a.name]["died"] += int(a.dead)
                for k in ("suicides", "kills", "score", "bombs"):
                    stats[a.name][k] += a.statistics.get(k, 0)
    finally:
        world.end()
    return stats


if __name__ == "__main__":
    suffix = sys.argv[1]          # "" for the frozen ship table
    n = int(sys.argv[2]); seed = int(sys.argv[3])
    if suffix:
        os.environ["BM_MODEL_SUFFIX"] = suffix
    stats = run(["benedict_task4"] + ["rule_based_agent"] * 3, n, seed, "kills")
    me = "benedict_task4"
    victim_of = Counter()
    for (v, o), c in PAIRS.items():
        victim_of[(v, "self" if v == o else "opp")] += c
    print(f"\n--- suffix={suffix!r} n={n} seed={seed} ---")
    print(f"{'agent':<22} {'died':>6} {'suic_stat':>10} {'blastby_self':>13} "
          f"{'blastby_opp':>12} {'kills_credited':>15} {'evalpy_kbo':>11}")
    for name in stats:
        d = stats[name]["died"]; su = stats[name]["suicides"]
        bs = victim_of[(name, "self")]; bo = victim_of[(name, "opp")]
        print(f"{name:<22} {d/n:>6.3f} {su/n:>10.3f} {bs/n:>13.3f} "
              f"{bo/n:>12.3f} {stats[name]['kills']/n:>15.3f} {max(0,d-su)/n:>11.3f}")
    print("\npair matrix (victim <- owner), per round:")
    for (v, o), c in sorted(PAIRS.items()):
        print(f"  {v:<22} <- {o:<22} {c/n:.4f}")
